{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Assurance Report Schema",
  "description": "Schema for structured assurance reports generated by the assurance system",
  "type": "object",
  "required": ["report_id", "timestamp", "target", "findings", "summary"],
  "properties": {
    "report_id": {
      "type": "string",
      "description": "Unique identifier for this assurance report",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the report was generated"
    },
    "target": {
      "type": "object",
      "description": "Information about the analyzed target",
      "required": ["path", "type"],
      "properties": {
        "path": {
          "type": "string",
          "description": "Path to the analyzed directory or file"
        },
        "type": {
          "type": "string",
          "enum": ["source_code", "binary", "configuration", "container", "firmware"],
          "description": "Type of target analyzed"
        },
        "size_bytes": {
          "type": "integer",
          "description": "Total size of analyzed target in bytes"
        },
        "file_count": {
          "type": "integer",
          "description": "Number of files analyzed"
        },
        "hash": {
          "type": "string",
          "description": "Cryptographic hash (SHA-256) of the target for verification"
        }
      }
    },
    "analyzer_info": {
      "type": "object",
      "description": "Information about the assurance system that generated this report",
      "required": ["version", "configuration"],
      "properties": {
        "version": {
          "type": "string",
          "description": "Version of the assurance system"
        },
        "configuration": {
          "type": "object",
          "description": "Configuration used for this analysis",
          "properties": {
            "confidence_threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "max_file_size_mb": {
              "type": "integer"
            },
            "timeout_seconds": {
              "type": "integer"
            },
            "enabled_analyzers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "description": "Array of security/quality findings",
      "items": {
        "type": "object",
        "required": ["finding_id", "type", "description", "location", "confidence", "severity"],
        "properties": {
          "finding_id": {
            "type": "string",
            "description": "Unique identifier for this finding within the report"
          },
          "type": {
            "type": "string",
            "description": "Category of finding (e.g., vulnerability, code_smell, compliance_violation)",
            "enum": ["vulnerability", "code_smell", "compliance_violation", "configuration_issue", "dependency_issue", "architecture_issue"]
          },
          "subtype": {
            "type": "string",
            "description": "More specific subtype of the finding (e.g., sql_injection, hardcoded_password)"
          },
          "description": {
            "type": "string",
            "description": "Detailed description of the finding"
          },
          "location": {
            "type": "object",
            "description": "Location of the finding in the target",
            "required": ["file"],
            "properties": {
              "file": {
                "type": "string",
                "description": "Path to the file containing the finding (relative to target root)"
              },
              "line_start": {
                "type": "integer",
                "description": "Starting line number (1-based)"
              },
              "line_end": {
                "type": "integer",
                "description": "Ending line number (1-based, inclusive)"
              },
              "column_start": {
                "type": "integer",
                "description": "Starting column number (1-based)"
              },
              "column_end": {
                "type": "integer",
                "description": "Ending column number (1-based, inclusive)"
              },
              "function": {
                "type": "string",
                "description": "Name of the function or method containing the finding"
              },
              "code_snippet": {
                "type": "string",
                "description": "Relevant code snippet showing the finding"
              }
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Confidence score indicating likelihood that this is a true positive"
          },
          "severity": {
            "type": "string",
            "description": "Severity level of the finding",
            "enum": ["info", "low", "medium", "high", "critical"]
          },
          "cvss_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 10,
            "description": "CVSS v3.1 score if applicable"
          },
          "cwe_id": {
            "type": "string",
            "pattern": "^CWE-\\d+$",
            "description": "Common Weakness Enumeration identifier if applicable"
          },
          "evidence": {
            "type": "array",
            "description": "Supporting evidence for this finding",
            "items": {
              "type": "object",
              "required": ["type", "description"],
              "properties": {
                "type": {
                  "type": "string",
                  "description": "Type of evidence",
                  "enum": ["code_excerpt", "configuration_value", "dependency_info", "binary_analysis", "test_result", "log_entry"]
                },
                "description": {
                  "type": "string",
                  "description": "Description of the evidence"
                },
                "content": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object"
                    }
                  ]
                },
                "location": {
                  "type": "string",
                  "description": "Where this evidence was found"
                }
              }
            }
          },
          "affected_asset": {
            "type": "object",
            "description": "Information about what is affected by this finding",
            "properties": {
              "asset_type": {
                "type": "string",
                "description": "Type of asset affected",
                "enum": ["data", "functionality", "service", "network", "hardware"]
              },
              "asset_name": {
                "type": "string",
                "description": "Name or identifier of the affected asset"
              },
              "impact": {
                "type": "string",
                "description": "Description of potential impact if exploited"
              }
            }
          },
          "recommendation": {
            "type": "object",
            "description": "Recommended action to address this finding",
            "required": ["action", "priority"],
            "properties": {
              "action": {
                "type": "string",
                "description": "Specific recommended action to remediate or mitigate"
              },
              "priority": {
                "type": "string",
                "description": "Priority for addressing this recommendation",
                "enum": ["immediate", "high", "medium", "low"]
              },
              "effort_estimate": {
                "type": "string",
                "description": "Estimated effort to implement the recommendation",
                "enum": ["minimal", "moderate", "significant", "extensive"]
              },
              "references": {
                "type": "array",
                "description": "References to standards, best practices, or vulnerability databases",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "source": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "metadata": {
            "type": "object",
            "description": "Additional metadata about the finding",
            "properties": {
              "first_detected": {
                "type": "string",
                "format": "date-time",
                "description": "When this finding was first detected in the target (if known)"
              },
              "analyzer": {
                "type": "string",
                "description": "Which analyzer or detection method found this issue"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Tags for categorizing the finding"
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "description": "Summary statistics of the analysis",
      "required": ["total_findings", "findings_by_severity", "findings_by_type"],
      "properties": {
        "total_findings": {
          "type": "integer",
          "description": "Total number of findings"
        },
        "findings_by_severity": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "description": "Count of findings by severity level"
        },
        "findings_by_type": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "description": "Count of findings by type"
        },
        "confidence_stats": {
          "type": "object",
          "description": "Statistics about confidence scores",
          "properties": {
            "mean": {
              "type": "number"
            },
            "median": {
              "type": "number"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        },
        "coverage": {
          "type": "object",
          "description": "Information about analysis coverage",
          "properties": {
            "files_analyzed": {
              "type": "integer"
            },
            "files_skipped": {
              "type": "integer"
            },
            "lines_of_code": {
              "type": "integer"
            },
            "analysis_duration_seconds": {
              "type": "number"
            }
          }
        }
      }
    },
    "audit_trail": {
      "type": "array",
      "description": "Audit trail entries for reproducibility",
      "items": {
        "type": "object",
        "required": ["timestamp", "operation", "details"],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "operation": {
            "type": "string",
            "description": "Operation performed (e.g., 'scan_start', 'analyzer_run', 'report_generate')"
          },
          "details": {
            "type": "object",
            "description": "Details about the operation"
          },
          "operator": {
            "type": "string",
            "description": "User or system component that performed the operation"
          }
        }
      }
    }
  }
}